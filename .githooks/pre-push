#!/usr/bin/env bash
# Run the local gate before pushing.
#
# Enable with:  git config core.hooksPath .githooks
#
# Skip for a single push with:  NULLHERZ_SKIP_VERIFY=1 git push
set -euo pipefail
if [[ -n "${NULLHERZ_SKIP_VERIFY:-}" ]]; then
    echo "pre-push: skipped (NULLHERZ_SKIP_VERIFY set)"
    exit 0
fi
cd "$(git rev-parse --show-toplevel)"
exec scripts/verify.sh
